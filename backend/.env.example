# Database
DATABASE_URL=postgresql://user:password@localhost:5432/v2i_db

# Redis
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_SECRET=your_32_char_random_secret_here

# API Security
API_KEY_REQUIRED=false
V2I_API_KEY=your_internal_api_key_here
FRONTEND_ORIGIN=*

# SMS (Twilio / MSG91)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_token
TWILIO_FROM=+1234567890
MSG91_AUTH_KEY=your_msg91_key

# AI / LLM
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=your_gemini_key_here

# Storage
GCS_BUCKET=v2i-manifestos

# App
PORT=8080
NODE_ENV=development
DEMO_MODE=true

# Google Cloud Services
GOOGLE_CLOUD_PROJECT=vote2india-prod
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_MAPS_API_KEY=your_maps_key_here
FIREBASE_SERVICE_ACCOUNT={}
VERTEX_LOCATION=us-central1

# Gmail API
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_REDIRECT_URI=https://vote2india.vercel.app/auth/callback
