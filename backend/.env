# BACKEND ENVIRONMENT CONFIGURATION (V2I)
# All services listed below have generous free tiers suitable for Hackathon evaluation.

# AI SERVICE: Google Gemini (15 RPM Free Tier)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AUTH SERVICE: MSG91 (1,500 Free OTP Credits)
# Get your key at: https://msg91.com/
MSG91_AUTH_KEY=your_msg91_key_here

# DATABASE: Redis (Local or Redis Cloud Free Tier)
REDIS_URL=redis://localhost:6379

# SERVER CONFIG
PORT=8081
DEBUG=True
DEMO_MODE=True

# Google Cloud Services
GOOGLE_CLOUD_PROJECT=vote2india-prod
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_MAPS_API_KEY=your_maps_key_here
FIREBASE_SERVICE_ACCOUNT={}
VERTEX_LOCATION=us-central1

# Gmail API
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_REDIRECT_URI=https://vote2india.vercel.app/auth/callback
